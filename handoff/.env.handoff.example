# Handoff defaults — merge into your .env (do not commit secrets)

POSTGRES_USER=roadwatch
POSTGRES_PASSWORD=roadwatch
POSTGRES_DB=roadwatch
POSTGRES_HOST_PORT=5433

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Buffalo GoPro live stream (requires ~11 GB video folder — optional)
PRODUCER_SOURCE=video
VIDEO_SAMPLE_FPS=1

# Detection + weather models from handoff zip
MODEL_WEIGHTS_FILE=best.pt
WEATHER_CLS_FILE=weather_cls_buffalo.pt
CONF_THRES=0.25

WEATHER_LAT=42.8864
WEATHER_LON=-78.8784
NOAA_STATION_ID=USW00014733
VALIDATION_INTERVAL_SEC=120

KAFKA_BOOTSTRAP=localhost:29092
POSTGRES_DSN=postgresql://roadwatch:roadwatch@localhost:5433/roadwatch
MODEL_WEIGHTS=./model/weights/best.pt

# Local UI replay sampling (offline video analysis)
RW_SAMPLE_FPS=5
RW_CONF_THRESHOLD=0.25

# If videos are missing, switch producer to static images:
# PRODUCER_SOURCE=images
# FRAMES_DIR=./data/frames