# Local development defaults. Copy to .env and change values as needed.
POSTGRES_USER=roadwatch
POSTGRES_PASSWORD=roadwatch
POSTGRES_DB=roadwatch
# Host port for the Docker Postgres; 5433 avoids clashing with a native Windows PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
FRAME_DELAY=0.15
# Producer input: "video" streams the Buffalo GoPro drives (VIDEO_SAMPLE_FPS frames per second
# of footage, paced in real time); "images" replays data/frames.
PRODUCER_SOURCE=images
FRAMES_HOST_DIR=./data/frames
VIDEO_SAMPLE_FPS=1
CONF_THRES=0.25
# Checkpoint under model/weights/ loaded by yolo-consumer (e.g. best_norway.pt after fine-tuning).
MODEL_WEIGHTS_FILE=best.pt
# Weather classifier under model/weights/ (weather_cls.pt = original; weather_cls_buffalo.pt = + Buffalo footage).
WEATHER_CLS_FILE=weather_cls.pt

# Weather & Context-Enrichment Agent — camera location for external weather lookups.
# Defaults to Buffalo, NY (RoadWatch's target deployment region).
WEATHER_LAT=42.8864
WEATHER_LON=-78.8784

# Ground-Truth Validator — free, unauthenticated NOAA NCEI station + poll interval.
NOAA_STATION_ID=USW00014733
VALIDATION_INTERVAL_SEC=120

# Optional: 511NY developer API key for pulling live Buffalo I-190 camera snapshots
# with streaming/tools/buffalo_camera_sampler.py (manual tool, not part of the
# running pipeline). Register at https://511ny.org/developers/
NY511_API_KEY=

# Optional host-side values for running Python services outside Docker.
KAFKA_BOOTSTRAP=localhost:29092
POSTGRES_DSN=postgresql://roadwatch:roadwatch@localhost:5433/roadwatch
MODEL_WEIGHTS=./model/weights/best.pt
FRAMES_DIR=./data/frames

# Optional experiment tracking when training locally.
WANDB_API_KEY=
